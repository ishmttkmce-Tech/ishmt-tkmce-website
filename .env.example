# ISHMT RCT Students Chapter TKMCE - Environment Configuration
# Note: Keep your secret credentials in .env (never commit .env to Git)

# Contact Form Delivery Settings
CONTACT_RECEIVER_EMAIL=ishmt@tkmce.ac.in

# Option A: Resend API Key (Recommended for Vercel Serverless)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ISHMT TKMCE <inquiry@ishmt.tkmce.ac.in>

# Option B: Standard SMTP Mail Server (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
